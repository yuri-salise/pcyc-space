# App Configuration
NEXT_PUBLIC_APP_URL="https://pcyc-space.vercel.app"
NODE_ENV="production"
LOG_LEVEL="info"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
DB_POOL_MAX="10"

# Email (Brevo / Nodemailer)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your.brevo.login@email.com"
SMTP_PASSWORD="your-brevo-smtp-key"
EMAIL_FROM="PCYC Space <notifications@yourdomain.com>"
EMAIL_REPLY_TO="admin@yourdomain.com"

# Setup & Script Helpers (Optional - for scripts/create-admin.ts and scripts/seed.ts)
# ADMIN_EMAIL="admin@pcyc.ph"
# ADMIN_PASSWORD="your-initial-admin-password"
